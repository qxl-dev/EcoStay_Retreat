<resources>

    <!-- Modern application theme with eco-friendly design -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Background -->
        <item name="android:windowBackground">@color/eco_background</item>

        <!-- Primary brand colors -->
        <item name="colorPrimary">@color/eco_primary</item>
        <item name="colorPrimaryVariant">@color/eco_primary_dark</item>
        <item name="colorOnPrimary">@color/eco_white</item>

        <!-- Secondary colors -->
        <item name="colorSecondary">@color/eco_secondary</item>
        <item name="colorSecondaryVariant">@color/eco_secondary_dark</item>
        <item name="colorOnSecondary">@color/eco_white</item>

        <!-- Accent color -->
        <item name="colorAccent">@color/eco_accent</item>

        <!-- Surface colors -->
        <item name="colorSurface">@color/eco_surface</item>
        <item name="colorOnSurface">@color/eco_text_primary</item>

        <!-- Background colors -->
        <item name="android:colorBackground">@color/eco_background</item>
        <item name="colorOnBackground">@color/eco_text_primary</item>

        <!-- Text Colors -->
        <item name="android:textColorPrimary">@color/eco_text_primary</item>
        <item name="android:textColorSecondary">@color/eco_text_secondary</item>
        <item name="android:textColorHint">@color/eco_text_hint</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Action bar -->
        <item name="actionBarStyle">@style/EcoActionBarStyle</item>
    </style>

    <!-- Action Bar Style -->
    <style name="EcoActionBarStyle" parent="Widget.MaterialComponents.ActionBar.Primary">
        <item name="background">@color/eco_primary</item>
        <item name="titleTextColor">@color/eco_white</item>
    </style>

    <!-- Modern Button Styles -->
    <style name="EcoButtonPrimary">
        <!-- Background uses your selector -->
        <item name="android:background">@drawable/eco_button_primary</item>

        <!-- Text styling -->
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>

        <!-- Padding & layout spacing -->
        <item name="android:padding">12dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>


    <style name="EcoButtonSecondary">
        <item name="android:background">@drawable/eco_button_secondary</item>
        <item name="android:textColor">@color/eco_text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">18dp</item>
        <item name="android:paddingBottom">18dp</item>
        <item name="android:paddingStart">32dp</item>
        <item name="android:paddingEnd">32dp</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:gravity">center</item>
        <item name="android:elevation">4dp</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="EcoButtonAccent">
        <item name="android:background">@drawable/eco_button_accent</item>
        <item name="android:textColor">@color/eco_text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">18dp</item>
        <item name="android:paddingBottom">18dp</item>
        <item name="android:paddingStart">32dp</item>
        <item name="android:paddingEnd">32dp</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:gravity">center</item>
        <item name="android:elevation">8dp</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Card Style -->
    <style name="EcoCard">
        <item name="android:background">@drawable/eco_card_background</item>
        <item name="android:elevation">4dp</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:padding">16dp</item>
    </style>

    <!-- Modern Text Styles -->
    <style name="EcoTextTitle">
        <item name="android:textColor">@color/eco_text_primary</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="EcoTextSubtitle">
        <item name="android:textColor">@color/eco_text_secondary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="EcoTextBody">
        <item name="android:textColor">@color/eco_text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="EcoTextCaption">
        <item name="android:textColor">@color/eco_text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- Legacy style for compatibility -->
    <style name="CustomButtonStyle">
        <item name="android:background">@drawable/eco_button_primary</item>
        <item name="android:textColor">@color/eco_white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:gravity">center</item>
    </style>



</resources>
