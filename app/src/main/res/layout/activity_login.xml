<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/nature_bg"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center">

        <!-- Logo/Icon Section -->
        <LinearLayout
            android:orientation="vertical"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="48dp">

            <TextView
                android:text="🌿"
                android:textSize="64sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp" />

            <TextView
                android:text="EcoStay Retreat"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="@color/eco_black"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="4" />

            <TextView
                android:text="Your Sustainable Getaway"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:alpha="0.9"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

        </LinearLayout>

        <!-- Login Card -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/eco_card_background"
            android:padding="32dp"
            android:elevation="12dp">

            <TextView
                android:text="Welcome Back"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/eco_text_primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="32dp" />

            <!-- Email Input -->
            <EditText
                android:id="@+id/etEmail"
                android:hint="Email Address"
                android:inputType="textEmailAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/eco_text_primary"
                android:textColorHint="@color/eco_text_hint"
                android:textSize="16sp"
                android:background="@drawable/edit_text_border"
                android:padding="16dp"
                android:layout_marginBottom="16dp" />

            <!-- Password Input -->
            <EditText
                android:id="@+id/etPassword"
                android:hint="Password"
                android:inputType="textPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/eco_text_primary"
                android:textColorHint="@color/eco_text_hint"
                android:textSize="16sp"
                android:background="@drawable/edit_text_border"
                android:padding="16dp"
                android:layout_marginBottom="24dp" />

            <!-- Login Button -->
            <!-- Sign In Button -->
            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sign In"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:background="#2E7D32"
                android:padding="12dp"
                android:layout_marginBottom="16dp"
                android:layout_marginTop="8dp" />

            <!-- Create New Account Button -->
            <Button
                android:id="@+id/btnGoRegister"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Create New Account"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:background="#1B5E20"
                android:padding="12dp"
                android:layout_marginTop="8dp" />


        </LinearLayout>

        <!-- Footer Text -->
        <TextView
            android:text="🌱 Committed to Sustainable Tourism"
            android:textColor="@color/eco_white"
            android:textSize="14sp"
            android:alpha="0.8"
            android:gravity="center"
            android:layout_marginTop="32dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>

</ScrollView>
