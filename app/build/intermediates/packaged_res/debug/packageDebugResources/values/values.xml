    <color name="eco_accent_dark">#8B7A2A</color>
    <color name="eco_accent_light">#D4C96A</color>
    <color name="eco_background">#121212</color>
    <color name="eco_black">#121212</color>
    <color name="eco_blue">#039BE5</color>
    <color name="eco_earth">#8D6E63</color>
    <color name="eco_earth_dark">#5D4037</color>
    <color name="eco_earth_light">#D7CCC8</color>
    <color name="eco_error">#F44336</color>
    <color name="eco_gradient_end">#2D6A4F</color>
    <color name="eco_gradient_secondary_end">#40916C</color>
    <color name="eco_gradient_secondary_start">#2D6A4F</color>
    <color name="eco_gradient_start">#1B4332</color>
    <color name="eco_gray">#2C2C2C</color>
    <color name="eco_gray_dark">#121212</color>
    <color name="eco_gray_light">#BDBDBD</color>
    <color name="eco_green">#2E7D32</color>
    <color name="eco_green_dark">#1B5E20</color>
    <color name="eco_info">#00B4A0</color>
    <color name="eco_light_blue">#B3E5FC</color>
    <color name="eco_orange">#FF7043</color>
    <color name="eco_primary">#2D6A4F</color>
    <color name="eco_primary_dark">#1B4332</color>
    <color name="eco_primary_light">#40916C</color>
    <color name="eco_secondary">#00B4A0</color>
    <color name="eco_secondary_dark">#008B7A</color>
    <color name="eco_secondary_light">#4DD0C1</color>
    <color name="eco_sky">#00B4A0</color>
    <color name="eco_sky_dark">#008B7A</color>
    <color name="eco_sky_light">#4DD0C1</color>
    <color name="eco_success">#40916C</color>
    <color name="eco_surface">#1A1A1A</color>
    <color name="eco_surface_variant">#2C2C2C</color>
    <color name="eco_text_hint">#757575</color>
    <color name="eco_text_primary">#FFFFFF</color>
    <color name="eco_text_secondary">#BDBDBD</color>
    <color name="eco_warning">#B5A642</color>
    <color name="eco_white">#E6CBA8</color>
    <color name="eco_yellow">#FFEB3B</color>
    <color name="light_blue">#42A5F5</color>
    <color name="moss_green">#2D6A4F</color>
    <color name="olive_gold">#B5A642</color>
    <color name="sage_green">#40916C</color>
    <color name="sky_teal">#00B4A0</color>
    <color name="stone_gray">#2C2C2C</color>
    <color name="warm_beige">#E6CBA8</color>
    <color name="white">#FFFFFF</color>
    <string name="app_name">EcoStay Retreat</string>
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        
        <item name="android:windowBackground">@color/eco_background</item>

        
        <item name="colorPrimary">@color/eco_primary</item>
        <item name="colorPrimaryVariant">@color/eco_primary_dark</item>
        <item name="colorOnPrimary">@color/eco_white</item>

        
        <item name="colorSecondary">@color/eco_secondary</item>
        <item name="colorSecondaryVariant">@color/eco_secondary_dark</item>
        <item name="colorOnSecondary">@color/eco_white</item>

        
        <item name="colorAccent">@color/eco_accent</item>

        
        <item name="colorSurface">@color/eco_surface</item>
        <item name="colorOnSurface">@color/eco_text_primary</item>

        
        <item name="android:colorBackground">@color/eco_background</item>
        <item name="colorOnBackground">@color/eco_text_primary</item>

        
        <item name="android:textColorPrimary">@color/eco_text_primary</item>
        <item name="android:textColorSecondary">@color/eco_text_secondary</item>
        <item name="android:textColorHint">@color/eco_text_hint</item>

        
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>

        
        <item name="actionBarStyle">@style/EcoActionBarStyle</item>
    </style>
    <style name="Base.Theme.EcoStayRetreat" parent="Theme.Material3.DayNight.NoActionBar">
        
        <item name="colorButtonNormal">@android:color/transparent</item>
        <item name="colorControlHighlight">@android:color/transparent</item>
        <item name="colorPrimary">@android:color/transparent</item>

        
        <item name="android:windowBackground">@color/charcoal_black</item>
        <item name="android:navigationBarColor">@color/charcoal_black</item>
        <item name="android:statusBarColor">@color/deep_forest_green</item>
    </style>
    <style name="CustomButtonStyle">
        <item name="android:background">@drawable/eco_button_primary</item>
        <item name="android:textColor">@color/eco_white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="EcoActionBarStyle" parent="Widget.MaterialComponents.ActionBar.Primary">
        <item name="background">@color/eco_primary</item>
        <item name="titleTextColor">@color/eco_white</item>
    </style>
    <style name="EcoButtonAccent">
        <item name="android:background">@drawable/eco_button_accent</item>
        <item name="android:textColor">@color/eco_text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">18dp</item>
        <item name="android:paddingBottom">18dp</item>
        <item name="android:paddingStart">32dp</item>
        <item name="android:paddingEnd">32dp</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:gravity">center</item>
        <item name="android:elevation">8dp</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="EcoButtonPrimary">
        
        <item name="android:background">@drawable/eco_button_primary</item>

        
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>

        
        <item name="android:padding">12dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
    <style name="EcoButtonSecondary">
        <item name="android:background">@drawable/eco_button_secondary</item>
        <item name="android:textColor">@color/eco_text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">18dp</item>
        <item name="android:paddingBottom">18dp</item>
        <item name="android:paddingStart">32dp</item>
        <item name="android:paddingEnd">32dp</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:gravity">center</item>
        <item name="android:elevation">4dp</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="EcoCard">
        <item name="android:background">@drawable/eco_card_background</item>
        <item name="android:elevation">4dp</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:padding">16dp</item>
    </style>
    <style name="EcoTextBody">
        <item name="android:textColor">@color/eco_text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>
    <style name="EcoTextCaption">
        <item name="android:textColor">@color/eco_text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>
    <style name="EcoTextSubtitle">
        <item name="android:textColor">@color/eco_text_secondary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>
    <style name="EcoTextTitle">
        <item name="android:textColor">@color/eco_text_primary</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
    </style>
    <style name="Theme.EcoStayRetreat" parent="Base.Theme.EcoStayRetreat"/>
</resources>